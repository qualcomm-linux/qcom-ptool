{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/qualcomm-linux/qcom-ptool/board.schema.json",
    "title": "qcom-ptool board",
    "description": "The hardware of one board: its storage devices and their geometry, and the SoC part of the contents metadata. A platform pairs it with the flavors flashed onto it.",
    "type": "object",
    "additionalProperties": false,
    "required": ["storage"],
    "properties": {
        "contents": {
            "description": "The SoC part of the contents metadata (chip, chipset, additional-chipids and the boot-chain firmware 'common' entries), which a platform's contents is laid over.",
            "type": "object"
        },
        "storage": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "size"],
                "properties": {
                    "id": {
                        "description": "Storage identifier, unique within the board; names the output directory.",
                        "type": "string",
                        "minLength": 1
                    },
                    "type": {
                        "type": "string",
                        "enum": ["emmc", "nand", "nvme", "spinor", "ufs"]
                    },
                    "size": {"type": "integer", "minimum": 1},
                    "sector-size": {"type": "integer", "minimum": 1},
                    "write-protect-boundary": {"type": "integer", "minimum": 0},
                    "align-partitions": {"type": "integer", "minimum": 0}
                }
            }
        }
    }
}
